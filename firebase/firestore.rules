rules_version = '2';

// Released to the named database `personal-finance-dashboard-db` — firebase.json
// uses the multi-database (array) form, which binds this file to the
// `cloud.firestore/personal-finance-dashboard-db` release rather than the
// default one.
service cloud.firestore {
  match /databases/{database}/documents {

    // Everything a user owns lives under users/{userId}, so one rule covers
    // categories, transactions, budgets and profile.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
