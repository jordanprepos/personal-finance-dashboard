# Firebase web config — copy to .env and fill in from
# Firebase console → Project settings → Your apps → SDK setup and configuration.
#
# .env is gitignored; this file is the committed template. Never put real
# values here.
#
# These VITE_-prefixed values are inlined into the client bundle by design.
# Firebase web config is public identification, not a secret — access control
# lives in firebase/firestore.rules.

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Optional — only if you enable Analytics.
# VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
