{
  "name": "@expense-tracker/design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles/desktop.css": "./src/styles/desktop.css",
    "./styles/mobile.css": "./src/styles/mobile.css"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/styles/index.css --bundle --outfile=dist/styles.css",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "storybook": "storybook dev -p 6006",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@expense-tracker/shared": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "react": "^19.0.0",
    "react-dom": "^19.2.8",
    "storybook": "^10.6.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.6"
  }
}
